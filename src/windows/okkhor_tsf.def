; src/windows/okkhor_tsf.def
;
; The exports of an in-process COM server. Listing them in a module definition
; file keeps the names undecorated in both 32- and 64-bit builds.
EXPORTS
    DllGetClassObject   PRIVATE
    DllCanUnloadNow     PRIVATE
    DllRegisterServer   PRIVATE
    DllUnregisterServer PRIVATE
